rules_version = '2';

// Firestore security rules for SMARTMIZ.
//
// Goal (per the review): stop one user from tampering with ANOTHER user's data
// or spoofing the leaderboard. Scores are still computed on the client, so a
// user can self-report their own stats — that is intentional and consistent
// with the app keeping its owner "boost" mechanic.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The single hard-coded owner/admin account (keep in sync with src/lib/owner.ts).
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'muhammadibrohimov0306@gmail.com';
    }

    function isMemberOf(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Identity fields (uid/email) must stay fixed on a self-update, and the
    // admin flag must never be granted by the client — the app derives owner
    // status from the auth token, so a stored `isAdmin` must not be forgeable.
    function keepsIdentity(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('isAdmin', false)
             == resource.data.get('isAdmin', false);
    }

    // Self-reported stats must stay within reachable bounds. The client caps a
    // test at MAX_CORRECT_CHARS (190) — see src/lib/limits.ts — which is ~152 WPM
    // at the shortest duration, so 300 leaves headroom without allowing a
    // console-typed 9999 onto the leaderboard. Totals may only move forward,
    // by at most one test's worth per write.
    function statsWithinLimits() {
      let d = request.resource.data;
      let prevTests = resource.data.get('totalTests', 0);
      let prevChars = resource.data.get('totalCorrectChars', 0);
      return d.get('bestWpm', 0) >= 0 && d.get('bestWpm', 0) <= 300
        && d.get('averageWpm', 0) >= 0 && d.get('averageWpm', 0) <= 300
        && d.get('totalTests', 0) >= prevTests
        && d.get('totalTests', 0) <= prevTests + 1
        && d.get('totalCorrectChars', 0) >= prevChars
        && d.get('totalCorrectChars', 0) <= prevChars + 400;
    }

    // ---- User profiles / leaderboard ----
    match /typingUsers/{uid} {
      // Public read: the leaderboard page is viewable without signing in.
      allow read: if true;
      // A new profile must carry the creator's own uid and email, and may only
      // claim admin if the account really is the owner.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.get('isAdmin', false) == false || isOwner());
      // Self can update own stats; owner can reset any user (admin panel).
      allow update: if isOwner()
        || (request.auth.uid == uid && keepsIdentity(uid) && statsWithinLimits());
      allow delete: if isOwner();
    }

    // ---- Groups ----
    match /groups/{groupId} {
      // Signed-in users can read/list groups (needed to join by code).
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      // Owner of the group (or app owner) may fully edit/delete; any signed-in
      // user may edit only to join/leave (membership fields).
      allow update: if isOwner()
        || resource.data.ownerId == request.auth.uid
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'memberCount']));
      allow delete: if isOwner() || resource.data.ownerId == request.auth.uid;

      // Members / results: readable and writable by group members.
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isMemberOf(groupId) || isOwner();
        // Allow leaving: a user may remove their own member doc even after
        // they have already been taken out of the group's memberIds array.
        allow delete: if isOwner()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
      match /results/{resultId} {
        allow read: if isSignedIn();
        allow write: if isMemberOf(groupId) || isOwner();
      }
      // Battles: members can create/join/update; delete limited to creator/owner.
      match /battles/{battleId} {
        allow read: if isSignedIn();
        allow create: if isMemberOf(groupId);
        allow update: if isMemberOf(groupId) || isOwner();
        allow delete: if isOwner()
          || (isSignedIn() && resource.data.creatorId == request.auth.uid);
      }
    }

    // ---- Anti-cheat alerts ----
    // Any signed-in user can self-report exceeding the score cap; only the
    // owner (admin) can read or clear these.
    match /cheatAlerts/{alertId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isOwner();
    }
  }
}
